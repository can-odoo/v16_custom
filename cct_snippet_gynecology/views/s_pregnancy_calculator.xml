    <template id="snippets" inherit_id="website.snippets" name="Custom Snippets">
        <xpath expr="//*[@id='default_snippets']" position="before">
            <t id="x_theme_snippets">
                <div id="x_theme_snippets_category" class="o_panel">
                    <div class="o_panel_header">Theme</div>
                    <div class="o_panel_body">
                        <t t-snippet="cct_snippet_gynecology.s_pregnancy_calculator"                                     
                            t-thumbnail="/cct_snippet_gynecology/static/src/img/snippets_thumbs/calculator-svgrepo-com.svg">
                            <keywords>Snippet</keywords>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
    
    <!-- test -->
    <record id="cct_snippet_gynecology.s_chart_000_css" model="ir.asset">
        <field name="name">Pregnancy Calculator 000 CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">cct_snippet_gynecology/static/src/snippets/s_pregnancy_calculator/000.scss</field>
    </record>
